{
  "name": "@afloat/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Online rooms: a Cloudflare Worker with one Durable Object per room that runs the shared rules engine. Also serves the built client.",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../client/dist',{recursive:true})\" && wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@afloat/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  }
}
