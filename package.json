{
  "name": "afloat",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,rooms -c yellow,cyan \"npm run dev -w @afloat/client\" \"npm run dev -w @afloat/server\"",
    "build": "npm run build -w @afloat/client",
    "preview": "npm run preview -w @afloat/client",
    "deploy": "npm run build && npm run deploy -w @afloat/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @afloat/client"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "concurrently": "^10.0.5"
  }
}
